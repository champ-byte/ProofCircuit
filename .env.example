# ProofCircuit configuration. Copy to .env for local use; real environment variables take
# precedence over .env (cloud sessions can set keys in the environment settings instead).
# Never commit a populated .env. Leave keys blank to disable an integration cleanly.

APP_ENV=development
DEMO_MODE=true
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./data/proofcircuit.db
DATA_DIR=./data

# Reasoning: Gemini (free tier) is the default primary; OpenRouter is the optional fallback.
REASONER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Gemini 3.x only. Verified available to the configured key on 2026-10-29 via models.list:
# gemini-3.5-flash-lite (default), gemini-3.8-flash, gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOW_PAID_MODELS=false

FALLBACK_PROVIDER=openrouter
FALLBACK_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny

# Optional local Gemma via Ollama (not used unless REASONER/FALLBACK_PROVIDER=ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.0
OLLAMA_THINK=false

UVICORN_WORKERS=1
PAYTM_NAIVE_TIMEZONE=Asia/Kolkata
MAX_POD_REPAIR_ROUNDS=1
EVALUATION_TARGET_CASES=40
EVALUATION_SMOKE_CASES=10

REMINDERS_ENABLED=false
N8N_REMINDER_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_SERVICE_TOKEN=
BACKEND_BASE_URL=http://127.0.0.1:8000
REMINDER_DELAY_SECONDS=120
MAX_REMINDERS_PER_REQUEST_ROUND=1

AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=180
MODEL_TIMEOUT_SECONDS=60

MESSAGING_PROVIDER=local
MEMORY_PROVIDER=sql
# Staff voice notes (M5): disabled | faster_whisper (local; `uv sync --extra speech`) | sarvam (not implemented)
SPEECH_PROVIDER=disabled
WHISPER_MODEL=small
WHISPER_MODEL_DIR=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SPEECH_MAX_AUDIO_SECONDS=120
SPEECH_REQUIRE_PASSING_SMOKE=true
SPEECH_SMOKE_MAX_CER=0.35
OCR_PROVIDER=disabled
PAYTM_MODE=simulator
PAYTM_LIVE_ENABLED=false
AUTO_SUBMIT_SIMULATOR=true
SARVAM_API_KEY=

# Generate local values, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# In development a placeholder is replaced by an ephemeral random secret (sessions reset on restart).
DEMO_WEBHOOK_SECRET=replace-with-a-local-development-secret
SESSION_SECRET=replace-with-a-local-development-secret
